# Copy to .env for local development. Never commit real secrets.

# --- Django ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
SUPPORT_EMAIL=support@example.com
DJANGO_ADMIN_URL=admin/

# --- Database ---------------------------------------------------------------
# Leave unset for SQLite in development. Production must use PostgreSQL.
# DATABASE_URL=postgres://skillforge:skillforge@localhost:5432/skillforge

# --- Redis / Celery ---------------------------------------------------------
# Without REDIS_URL, a local-memory cache is used and Celery tasks run inline.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=false

# --- Email --------------------------------------------------------------------
# console (default: emails are printed), smtp, or locmem.
NOTIFICATION_BACKEND=console
# SMTP — e.g. Gmail with an app password (https://myaccount.google.com/apppasswords).
# Port 587 uses STARTTLS, 465 uses SSL. Spaces in a Google app password are removed automatically.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop            # SMTP_PASSWORD_VAULT_REF is accepted as an alias
# SMTP_FROM=you@gmail.com                      # sent as "SkillForge <you@gmail.com>"
# The Django names (EMAIL_BACKEND, EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
# EMAIL_USE_TLS, EMAIL_USE_SSL, EMAIL_TIMEOUT, DEFAULT_FROM_EMAIL) still work and take precedence.

# --- AI mentor (optional) ----------------------------------------------------
# Leave AI_PROVIDER empty to use curated guidance only.
AI_PROVIDER=
AI_MODEL=claude-opus-5-5
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4000
AI_EFFORT=medium
AI_USE_SERVER_FALLBACKS=true
AI_REQUESTS_PER_MINUTE=6

# --- Sandboxed code runner (optional, separate service) ---------------------
# Without these, Python coding challenges are clearly marked unavailable.
# CODE_RUNNER_URL=http://localhost:8080
CODE_RUNNER_TOKEN=change-me-shared-secret-between-web-and-runner
CODE_RUNNER_TIMEOUT_SECONDS=20

# --- Billing ------------------------------------------------------------------
# "dev" = local-only adapter (requires DEBUG), "stripe" = real payments, empty = disabled.
BILLING_PROVIDER=dev
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_INTERVIEW=price_...

# --- Operations ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
TRUSTED_PROXY_COUNT=0
RATELIMIT_ENABLED=true
