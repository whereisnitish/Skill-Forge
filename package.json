{
  "name": "skillforge-frontend",
  "private": true,
  "description": "Frontend asset pipeline for SkillForge (Tailwind CSS, CodeMirror bundle, vendored libraries).",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -i frontend/app.css -o static/dist/app.css --minify",
    "build:js": "esbuild frontend/editor.js --bundle --minify --format=iife --target=es2020 --outfile=static/dist/editor.js",
    "build": "npm run vendor && npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i frontend/app.css -o static/dist/app.css --watch"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/dm-serif-display": "5.2.8",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/cli": "4.3.3",
    "chart.js": "4.5.1",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "htmx.org": "2.0.11",
    "lucide-static": "1.61.0",
    "tailwindcss": "4.3.3"
  }
}
